{
  "name": "codex-desktop-glm-version",
  "private": true,
  "description": "Restored TypeScript sources of the Codex (ChatGPT) desktop app for macOS. Recovered from the shipped app.asar; see README.md for what could and could not be restored.",
  "type": "module",
  "scripts": {
    "restore": "node --max-old-space-size=8192 scripts/restore-ts.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "typecheck": "tsc --noEmit",
    "build-renderer": "node scripts/build-renderer.mjs",
    "promote-exact-renderer-route-sources": "node scripts/promote-exact-renderer-route-sources.mjs",
    "recover-renderer-route-source": "node scripts/recover-renderer-route-source.mjs",
    "verify-renderer": "node scripts/verify-renderer.mjs",
    "verify-renderer-fidelity": "node scripts/test-renderer-owner-fidelity-boundary.mjs",
    "verify-renderer-cluster": "node scripts/verify-renderer-cluster.mjs",
    "e2e:inspect": "node scripts/inspect-electron-renderer.mjs",
    "e2e:readonly": "node scripts/e2e-electron-renderer.mjs smoke-readonly",
    "e2e:critical": "node scripts/e2e-packaged-critical.mjs",
    "e2e:critical:attached": "node scripts/e2e-critical.mjs",
    "verify": "node scripts/verify-chunks.mjs",
    "audit-test-index": "node scripts/audit-test-index.mjs",
    "pack": "./scripts/pack.sh",
    "setup": "./scripts/setup-shell.sh",
    "start": "npm run pack && ./scripts/run.sh"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/ws": "8.18.1",
    "acorn": "^8.18.0",
    "electron": "42.3.0",
    "esbuild": "*",
    "prettier": "^3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/xterm": "5.5.0",
    "capnweb": "0.12.0",
    "immer": "10.1.1",
    "smol-toml": "1.7.0",
    "socks-proxy-agent": "8.0.5",
    "ws": "8.21.1",
    "yaml": "2.9.0",
    "zod": "3.25.76"
  }
}
