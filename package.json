{
  "name": "codex-desktop-glm-version",
  "private": true,
  "description": "Restored TypeScript sources of the Codex (ChatGPT) desktop app for macOS. Recovered from the shipped app.asar; see README.md for what could and could not be restored.",
  "type": "module",
  "scripts": {
    "restore": "node --max-old-space-size=8192 scripts/restore-ts.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "typecheck": "tsc --noEmit",
    "build-renderer": "node scripts/build-renderer.mjs",
    "verify-renderer": "node scripts/verify-renderer.mjs",
    "verify-renderer-cluster": "node scripts/verify-renderer-cluster.mjs",
    "verify": "node scripts/verify-chunks.mjs",
    "audit-test-index": "node scripts/audit-test-index.mjs",
    "pack": "./scripts/pack.sh",
    "setup": "./scripts/setup-shell.sh",
    "start": "npm run build && npm run pack && ./scripts/run.sh"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "acorn": "^8.18.0",
    "electron": "42.3.0",
    "esbuild": "*",
    "prettier": "^3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "immer": "10.1.1",
    "yaml": "2.9.0",
    "zod": "3.25.76"
  }
}
